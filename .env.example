# ---------- Database (Neon Postgres) ----------
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------- Monime (payments) ----------
MONIME_API_KEY=your_monime_api_key
MONIME_SPACE_ID=your_monime_space_id
# Secret you set in the Monime dashboard to verify webhook signatures
MONIME_WEBHOOK_SECRET=your_monime_webhook_secret

# Optional: override checkout redirect URLs
# CHECKOUT_SUCCESS_URL=https://your-domain.com/success
# CHECKOUT_CANCEL_URL=https://your-domain.com

# ---------- Brevo (transactional email) ----------
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=fund@maseraytemneblogger.com
BREVO_SENDER_NAME="Maseray Temne Blogger Fund"
# Comma-separated admin emails to notify
ADMIN_ALERT_EMAILS=admin@example.com

# ---------- UploadThing (file uploads) ----------
UPLOADTHING_TOKEN=your_uploadthing_token

# ---------- Admin auth ----------
# Secret used to sign the admin session cookie (use a long random string)
AUTH_SECRET=change_me_to_a_long_random_string
# Base URL of the app (used for links in emails)
APP_URL=http://localhost:3000
